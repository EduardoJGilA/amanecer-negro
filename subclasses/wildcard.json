        {
            "name": "Tricks Up the Sleeve",
            "source": "WildCardHomebrew",
            "className": "Rogue",
            "classSource": "PHB",
            "subclassShortName": "Wild Card",
            "subclassSource": "WildCardHomebrew",
            "level": 3,
            "header": 1,
            "entries": [
                "You learn the {@spell guidance} cantrip.",
                {
                    "type": "entries",
                    "name": "Level 9 Upgrade",
                    "entries": [
                        "Starting at 9th level, this spell has a range of 30 feet for you and you can cast it as a bonus action."
                    ]
                }
            ]
        },
        {
            "name": "Wildcard's Gambit",
            "source": "WildCardHomebrew",
            "className": "Rogue",
            "classSource": "PHB",
            "subclassShortName": "Wild Card",
            "subclassSource": "WildCardHomebrew",
            "level": 3,
            "header": 1,
            "entries": [
                "You gain proficiency with {@item Gaming Set|PHB|playing cards}. You have access to the {@item Deck of Cards|WildCardHomebrew} weapon and its {@item Card|WildCardHomebrew} ammunition. You can use an enchanted card to make a ranged weapon attack (60 ft range). The attack uses your Dexterity modifier and deals damage based on your level.",
                "This card counts as a weapon with the Finesse property for applying your {@classFeature Sneak Attack|Rogue|PHB|1|PHB}.",
                "You have a number of uses equal to your Charisma modifier (minimum of 1) per long rest.",
                {
                    "type": "table",
                    "caption": "Base Damage and Range",
                    "colLabels": [
                        "Level",
                        "Base Damage",
                        "Range"
                    ],
                    "colStyles": [
                        "col-2 text-center",
                        "col-4 text-center",
                        "col-6 text-center"
                    ],
                    "rows": [
                        [
                            "1–2",
                            "{@dice 1d4}",
                            "30/60 ft."
                        ],
                        [
                            "3–4",
                            "{@dice 1d6}",
                            "60/120 ft."
                        ],
                        [
                            "5–6",
                            "{@dice 1d8}",
                            "60/120 ft."
                        ],
                        [
                            "7–8",
                            "{@dice 1d10}",
                            "90/180 ft."
                        ],
                        [
                            "9–12",
                            "{@dice 1d12}",
                            "90/180 ft."
                        ],
                        [
                            "13–16",
                            "{@dice 2d8}",
                            "120/240 ft."
                        ],
                        [
                            "17–20",
                            "{@dice 2d10}",
                            "120/240 ft."
                        ]
                    ]
                },
                {
                    "type": "list",
                    "name": "Wildcard Effects Table (Save DC = 8 + Proficiency + Charisma Mod)",
                    "items": [
                        "{@b 1. Dagger (Level 3):} If you apply Sneak Attack, the target takes extra slashing damage equal to half your Sneak Attack damage at the start of its next turn.",
                        "{@b 2. Chains (Level 3):} Target must make a {@savingThrow Strength} or {@savingThrow Dexterity} save or become {@condition grappled} until your next turn.",
                        "{@b 3. Heart (Level 3):} Regain HP equal to half Sneak Attack damage (excess becomes temporary HP).",
                        "{@b 4. Frost (Level 6):} Target has disadvantage on attack rolls during its next turn.",
                        "{@b 5. The Crown (Level 6):} Target must make a {@savingThrow Wisdom} save or use its reaction to attack an ally of your choice.",
                        "{@b 7. Death (Level 9):} If target has 30 HP or lower, it must pass a {@savingThrow Constitution} save or die instantly; if successful, it is {@condition paralyzed}.",
                        "{@b 8. The Wheel (Level 13):} Target must pass a {@savingThrow Dexterity} save or fall {@condition prone}.",
                        "{@b 10. Judgment (Level 17):} Target must pass a {@savingThrow Wisdom} save or become {@condition paralyzed} and gain vulnerability to all damage."
                    ]
                }
            ]
        },
        {
            "name": "Shift the Odds",
            "source": "WildCardHomebrew",
            "className": "Rogue",
            "classSource": "PHB",
            "subclassShortName": "Wild Card",
            "subclassSource": "WildCardHomebrew",
            "level": 9,
            "header": 2,
            "entries": [
                "As a bonus action, creatures within 10 feet make a {@savingThrow Dexterity} save (DC 8 + Proficiency + Charisma Mod) or take {@damage 6d10} force damage and fall {@condition prone}. Then you teleport up to 60 feet.",
                "You gain resistance to all damage and advantage on Dexterity saves until your next turn. Regained after a short or long rest."
            ]
        },
        {
            "name": "Twist of Fate",
            "source": "WildCardHomebrew",
            "className": "Rogue",
            "classSource": "PHB",
            "subclassShortName": "Wild Card",
            "subclassSource": "WildCardHomebrew",
            "level": 13,
            "header": 2,
            "entries": [
                "You can swap initiative with a creature you can see. Enemies must make a {@savingThrow Wisdom} save (DC 8 + Proficiency + Charisma Mod).",
                "You and an ally gain +10 ft speed and advantage on the first attack roll of combat."
            ]
        },
        {
            "name": "Joker's Wild",
            "source": "WildCardHomebrew",
            "className": "Rogue",
            "classSource": "PHB",
            "subclassShortName": "Wild Card",
            "subclassSource": "WildCardHomebrew",
            "level": 17,
            "header": 2,
            "entries": [
                "As a bonus action, you enter an incorporeal form for 1 minute.",
                {
                    "type": "list",
                    "items": [
                        "Regain spent uses of Wildcard's Gambit.",
                        "Doubled speed.",
                        "Resistance to all damage and immunity to {@condition grappled}, {@condition paralyzed}, {@condition stunned}, and {@condition restrained}.",
                        "You can move through objects and creatures. If you end inside a creature, it takes {@damage 1d10} force damage."
                    ]
                },
                "Regained after a long rest."
            ]
        }
    ],
