    "subclassFeature": [
        {
            "name": "Pale Master",
            "source": "AN",
            "className": "Sorcerer",
            "classSource": "PHB",
            "subclassShortName": "Pale Master",
            "subclassSource": "AN",
            "level": 1,
            "entries": [
                "Your powers are necromantic in origin, your flesh petrified and corrupted. You are a living mind trapped within a decaying corpse.",
                {
                    "type": "refSubclassFeature",
                    "subclassFeature": "Deathsign|Sorcerer|PHB|Pale Master|AN|1"
                },
                {
                    "type": "refSubclassFeature",
                    "subclassFeature": "Undead Cohort|Sorcerer|PHB|Pale Master|AN|1"
                }
            ]
        },
        {
            "name": "Deathsign",
            "source": "AN",
            "className": "Sorcerer",
            "classSource": "PHB",
            "subclassShortName": "Pale Master",
            "subclassSource": "AN",
            "level": 1,
            "header": 1,
            "entries": [
                "You are marked with death. Whenever you would normally take necrotic damage from a spell of 1st level or higher, you instead regain hit points equal to half the necrotic damage dealt (rounded down).",
                "Additionally, you learn bonus necromancy spells that do not count against your total number of sorcerer spells known:",
                {
                    "type": "list",
                    "items": [
                        "{@b 1st:} {@spell inflict wounds}",
                        "{@b 3rd:} {@spell ray of enfeeblement}",
                        "{@b 5th:} {@spell animate dead}",
                        "{@b 7th:} {@spell blight}",
                        "{@b 9th:} {@spell contagion}",
                        "{@b 11th:} {@spell create undead}"
                    ]
                }
            ]
        },
        {
            "name": "Undead Cohort",
            "source": "AN",
            "className": "Sorcerer",
            "classSource": "PHB",
            "subclassShortName": "Pale Master",
            "subclassSource": "AN",
            "level": 1,
            "header": 1,
            "entries": [
                "You can control undead creatures under your command. You can control a maximum number of creatures equal to your proficiency bonus.",
                "The maximum Challenge Rating (CR) of an undead cohort cannot exceed half your sorcerer level (rounded down).",
                "Maintaining control requires spending sorcery points each day according to the table:",
                {
                    "type": "table",
                    "caption": "Undead Cohort Cost",
                    "colLabels": [
                        "CR",
                        "Sorcery Points"
                    ],
                    "colStyles": [
                        "col-6",
                        "col-6"
                    ],
                    "rows": [
                        [
                            "1/8",
                            "1"
                        ],
                        [
                            "1/4",
                            "2"
                        ],
                        [
                            "1/2",
                            "3"
                        ],
                        [
                            "1",
                            "4"
                        ],
                        [
                            "2",
                            "5"
                        ],
                        [
                            "3",
                            "6"
                        ],
                        [
                            "4",
                            "7"
                        ],
                        [
                            "5",
                            "8"
                        ],
                        [
                            "6",
                            "9"
                        ],
                        [
                            "7",
                            "10"
                        ],
                        [
                            "8",
                            "11"
                        ],
                        [
                            "9",
                            "12"
                        ],
                        [
                            "10",
                            "13"
                        ]
                    ]
                },
                "Each day at dawn, you must make a Constitution check (DC 10 + highest CR + Wisdom modifier of your Undead Cohort) to maintain control over your cohort."
            ]
        },
        {
            "name": "Emissary of Death",
            "source": "AN",
            "className": "Sorcerer",
            "classSource": "PHB",
            "subclassShortName": "Pale Master",
            "subclassSource": "AN",
            "level": 6,
            "header": 2,
            "entries": [
                "Whenever you deal damage with a necromancy spell, you can add your {@b Charisma} modifier to the damage roll.",
                "When you do so, you can spend 1 sorcery point to gain {@dice 1d10} temporary hit points."
            ]
        },
        {
            "name": "Spellstitched Cohort",
            "source": "AN",
            "className": "Sorcerer",
            "classSource": "PHB",
            "subclassShortName": "Pale Master",
            "subclassSource": "AN",
            "level": 14,
            "header": 2,
            "entries": [
                "Your cohort improves. It learns one necromancy cantrip of your choice which it can cast on its turn using your sorcerer level.",
                "Additionally, your Deathsign extends to your cohorts: whenever one of them receives necrotic damage from a non-cantrip source, it instead regains hit points equal to the necrotic damage taken."
            ]
        },
        {
            "name": "Overlord",
            "source": "AN",
            "className": "Sorcerer",
            "classSource": "PHB",
            "subclassShortName": "Pale Master",
            "subclassSource": "AN",
            "level": 18,
            "header": 2,
            "entries": [
                "At 18th level, when you cast {@spell animate dead} to reassert control over undead, you can spend sorcery points to cast it as if using a spell slot one level higher for each point spent."
            ]
        }
    ]
